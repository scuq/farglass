{
  "manifest_version": 3,
  "name": "farglass video redirection",
  "version": "0.1.0",
  "description": "Plays the videos of web pages in the browser of the farglass client, with its own decoder.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["relay.js"], "run_at": "document_start" }
  ]
}
